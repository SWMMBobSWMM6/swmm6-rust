[CONDUITS]
C1 J1 O1 100 0.01 0 0 0 0

[XSECTIONS]
C1 CIRCULAR 1 0 0 0 1

[2D_NODE_COUPLING]
; comment
J1 MANHOLE
J2 manhole D=1.2 PERIMETER=3.77 AREA=1.13 CHAMBER_AREA=1.5 LID_OPEN_FRACTION=0.25 CREST=node_rim COEFFS=RUBINATO2017_UPPER CW=1.7 CSW=1.6 COI=0.6 COO=0.61 LAW=WEIR_ORIFICE
J3 GRATE AREA=0.5 CREST=MESH_BED COEFFS=default LAW=orifice
J4 CURB PERIMETER=2 CREST=MAX COEFFS=RUBINATO2017 LID_OPEN_FRACTION=1
J5 NONE
J6,GRATE,AREA=2,CREST=MIN,COEFFS=RUBINATO2017_LOWER
