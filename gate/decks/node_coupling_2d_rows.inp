[TITLE]
synthetic: [2D_NODE_COUPLING], every branch of nodecoupling2d::readSection

[OPTIONS]
FLOW_UNITS CFS
FLOW_ROUTING DYNWAVE

[2D_NODE_COUPLING]
;; ahead of the node: deferred, then replayed
LATE MANHOLE D=1.2
GHOST GRATE

[JUNCTIONS]
