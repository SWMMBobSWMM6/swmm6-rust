[REACTION_SPECIES]
BULK A MG
BULK B MG
WALL W MG
BULK E MG
BULK F MG
BULK G MG
BULK H MG
BULK I MG
BULK J MG
[REACTION_COEFFICIENTS]
CONSTANT k 1
[REACTION_TERMS]
fwd t2 + 1
t2 A + Q
t3 A # B
t4 2 3
t5 A B
t6 EXP 2
t7 MIN(A)
t8 MAX(A,B,A)
t9 A)
t10 (A
t11 A +
t12 ,A
t13 A, B
t14 Zed
t15 *A
t16 1e
t17 ((((((((((((((((((((((((((((((((((A))))))))))))))))))))))))))))))))))
t18 .
t19 "A + B"
t20 A + "B"
t21 +-+-A
t22 AV
t23 GW_POROSITY
[REACTION_PIPES]
RATE A t2
RATE B D
RATE W GW_THETA
RATE E t23
RATE F t21
[REACTION_TANKS]
RATE A Q*U
[REACTION_SUBCATCHMENTS]
RATE A HRT
RATE B W
RATE E t21
SUBCATCHMENT S1 RATE F A*0 + 1
[REACTION_BUILDUP]
LANDUSE Res RATE G k
LANDUSE Res RATE H AV
[REACTION_SUBSURFACE]
* SAT A RATE W
* SAT B RATE HRT
* UNSAT E RATE GW_SE + TEMP
[REACTION_LIDS]
CONTROL BC1 LAYER 9 RATE A 1
CONTROL BC1 LAYER 1 RATE B TSS
[REACTION_WALLS]
LINK C1 5
