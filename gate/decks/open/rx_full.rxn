[REACTION_OPTIONS]
SOLVER ROS2
COUPLING FULL
RATE_UNITS DAY
WALL_GEOMETRY YES
AREA_UNITS M2
TIMESTEP 30
PATTERN_TIMESTEP 1800
ATOL 1e-7
RTOL 1e-5
TEMPERATURE 15.5
X
[REACTION_SPECIES]
BULK A MG 1e-6 1e-4
BULK B UG
WALL W MG/L
BULK C COUNT
[REACTION_COEFFICIENTS]
PARAMETER k 0.25
CONSTANT kw 1.5e-3
PARAMETER kb .5
[REACTION_TERMS]
t1 k*A + 0x10*0
t2 t1*2 - MIN(A, B)
t3 EXP(-k*TEMP) * POW(A,2) + -A^2 + LOG(1+A) + LOG10(2) + SQRT(4) + ABS(-1) + SGN(A) + STEP(A) + SIN(1)+COS(1)+TAN(1)+MAX(1,2) + GW_THETA*0
[REACTION_PIPES]
RATE A -t1 + TSS*0
EQUIL B A - B
RATE W kw*A*AV - HRT*0
FORMULA C 2*A
[REACTION_TANKS]
RATE A -k*A + DT*0
RATE W kw*A
[REACTION_SUBCATCHMENTS]
RATE A -k*A*TEMP
SUBCATCHMENT S1 RATE B -kb*B + DT*0
[REACTION_BUILDUP]
LANDUSE Res RATE A 0.1
SUBCATCHMENT S1 LANDUSE Res FORMULA B 2*A
[REACTION_SUBSURFACE]
* SAT A RATE -k*A*GW_SE
TAG zone1 UNSAT B EQUIL A
CELL 3 LAYER 2 C FORMULA GW_DEPTH_M + DT
[REACTION_QUALITY]
GLOBAL A 1.5
NODE J1 B 2
LINK C1 A 3
[REACTION_RAINFALL]
A 0.2
C 0
[REACTION_PATTERNS]
pat1 1 2 3
pat2 0.5
pat1 4
[REACTION_SOURCES]
CONC J1 A 10
MASS J2 B 5 pat1
FLOWPACED T1 A 1 *
SETPOINT J2 C 2 pat2
[REACTION_PARAMETERS]
NODE J1 k 0.3
LINK C1 kb 0.7
[REACTION_REPORT]
SPECIES ALL YES
SPECIES C NO
[REACTION_WALLS]
NODE T1 100
LINK C1 500
[REACTION_LIDS]
CONTROL BC1 TRANSPORT
CONTROL BC1 LAYER 2 RATE A -k*A
CONTROL BC1 LAYER 0 FORMULA B 0.5*A
