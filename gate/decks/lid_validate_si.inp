[TITLE]
synthetic: lidnode::validate in SI units (rain depth in mm, MaxDepth in m)

[OPTIONS]
FLOW_UNITS CMS
FLOW_ROUTING DYNWAVE

[STORAGE]
A 0 0.75 0 FUNCTIONAL 0 0 100 0 0
B 0 0.76 0 FUNCTIONAL 0 0 100 0 0
O 0 5 0 FUNCTIONAL 0 0 100 0 0

[OUTFALLS]
F 0 FREE NO

[CONDUITS]
C1 A O 10 0.01 0.45 0 0 0
C2 B O 10 0.01 0.45 0 0 0

[XSECTIONS]
C1 CIRCULAR .3 0 0 0 1
C2 CIRCULAR .3 0 0 0 1

[LID_CONTROLS]
Metric NODE
Metric SURFACE 150 .1
Metric MEDIA 300 .45 .20 .08 50 3 30
Metric AGGREGATE 300 .40 1000
Metric BOTTOM 0 0

[LID_NODES]
A Metric 10
B Metric 10

[LID_NODE_OUTLETS]
C1 2 BOTTOM
C2 2 TOP
