[TITLE]
synthetic: [LID_NODE_OUTLETS], every branch of lidnode::readOutlets

[OPTIONS]
FLOW_UNITS CFS
FLOW_ROUTING DYNWAVE

[LID_NODE_OUTLETS]
;; anchors ahead of their links: deferred, then replayed
EARLYLINK 1 TOP
GHOSTLINK 1 TOP
EARLYBAD 0 TOP

[STORAGE]
A 0 2.5 0 FUNCTIONAL 0 0 1000 0 0
B 0 2.5 0 FUNCTIONAL 0 0 1000 0 0

[OUTFALLS]
O1 0 FREE NO

[CONDUITS]
C1 A B 100 0.01 0 0 0 0
C2 A O1 100 0.01 0 0 0 0
C3 B O1 100 0.01 0 0 0 0
C4 A B 100 0.01 0 0 0 0
C5 A B 100 0.01 0 0 0 0
C6 A B 100 0.01 0 0 0 0
C7 A B 100 0.01 0 0 0 0
EARLYLINK A B 100 0.01 0 0 0 0
EARLYBAD A B 100 0.01 0 0 0 0

[XSECTIONS]
C1 CIRCULAR 1 0 0 0 1
C2 CIRCULAR 1 0 0 0 1
C3 CIRCULAR 1 0 0 0 1
C4 CIRCULAR 1 0 0 0 1
C5 CIRCULAR 1 0 0 0 1
C6 CIRCULAR 1 0 0 0 1
C7 CIRCULAR 1 0 0 0 1
EARLYLINK CIRCULAR 1 0 0 0 1
EARLYBAD CIRCULAR 1 0 0 0 1

[LID_NODE_OUTLETS]
; comment
C1 1 TOP
C2 2 bottom
C3 1e0 Top
C4 0x2 BOTTOM
C5 2147483647 TOP
C7 "  3" BOTTOM
C6 2147483648 TOP
C6 0 TOP
C6 -1 TOP
C6 1.5 TOP
C6 nan TOP
C6 inf TOP
C6 abc TOP
C6 1 MIDDLE
C6 1
C6 1 TOP extra
C6
C1 2 BOTTOM
c2 1 TOP
